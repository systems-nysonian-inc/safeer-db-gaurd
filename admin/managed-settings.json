{
  "extraKnownMarketplaces": {
    "nysonian": {
      "source": { "source": "github", "repo": "systems-nysonian-inc/safeer-db-gaurd" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "db-write-guard@nysonian": true
  },
  "strictKnownMarketplaces": [
    { "source": "github", "repo": "systems-nysonian-inc/safeer-db-gaurd" },
    { "source": "github", "repo": "anthropics/claude-plugins-official" },
    { "source": "skills-dir" }
  ],
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.pgpass)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  }
}
